# Copy to .env (or .env.private) and fill in. Never commit the filled file.

# Naver CLOVA Speech (long-sentence recognizer, upload API)
CLOVA_SPEECH_SECRET_KEY=<your-clova-speech-secret-key>
CLOVA_SPEECH_INVOKE_URL=<your-clova-speech-invoke-url>

# Azure AI Speech (conversation transcription v1, ko-KR)
AZURE_SPEECH_KEY=<your-azure-speech-key>
AZURE_SPEECH_REGION=koreacentral

# OpenAI Whisper API
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_WHISPER_MODEL=whisper-1

# Google Speech-to-Text v2 (latest_long)
# Put the service-account JSON under secrets/google-service-account.json (git-ignored).
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
GOOGLE_CLOUD_PROJECT=<your-google-cloud-project-id>
GOOGLE_SPEECH_LOCATION=global
GOOGLE_SPEECH_RECOGNIZER=_

# AssemblyAI (v2 transcript API)
ASSEMBLYAI_API_KEY=<your-assemblyai-api-key>
